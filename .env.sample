# Gemini API key (required). API_KEY is also accepted.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: pin a specific store; otherwise the store is found/created by display name
GEMINI_FILE_SEARCH_STORE=
STORE_DISPLAY_NAME=support-kb
GEMINI_MODEL=gemini-3.5-flash

# Scraper (MAX_ARTICLES=0 means all published articles)
ZENDESK_DOMAIN=https://support.optisigns.com
MAX_ARTICLES=0
ARTICLES_DIR=data/articles
UPLOAD_CONCURRENCY=5
